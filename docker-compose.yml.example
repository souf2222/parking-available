services:
  parking-backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: parking-backend
    environment:
      - NODE_ENV=${NODE_ENV}
      - PORT=${BACKEND_PORT}
      - JWT_SECRET=${JWT_SECRET}
    volumes:
      - backend_data:/app/data
    networks:
      - network1
    restart: unless-stopped
    labels:
      - "traefik.enable=false"

  parking-frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: parking-frontend
    depends_on:
      - parking-backend
    networks:
      - qcav-network1
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.parking-frontend.rule=Host(`${FRONTEND_DOMAIN}`)"
      - "traefik.http.routers.parking-frontend.entrypoints=https"

volumes:
  backend_data:

networks:
  network1:
    external: true
